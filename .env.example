# Copy this file to .env.local and fill in your real key.
# .env.local is git-ignored — it will never be committed.

# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override which Claude model handles requests.
# Defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5

# Used to turn uploaded document text into embeddings for semantic search.
# Get a free key from https://dashboard.voyageai.com/
VOYAGE_API_KEY=pa-your-voyage-key-here

# Optional: override which Voyage embedding model handles requests.
# Defaults to voyage-4 if not set.
VOYAGE_MODEL=voyage-4
